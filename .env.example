# ===== 数据库配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=stock_analysis

# ===== 定时任务（工作日）=====
# 盘前分析 .env 里配置的股票池，出分数/行业/消息面/技术位，落库 + HTML + 邮件
PREMARKET_TIME=08:30
# 收盘后腾讯通道全市场日更（日线/估值/快照/特征）。必须当天收盘后跑。
# ⚠ 若同时启用 WorkBuddy 外部 16:30 自动化，两边会各跑一次（幂等 UPSERT，不写坏数据，但白跑 5~6 分钟）
DAILY_UPDATE_TIME=16:30

# ===== 盯盘股票池 =====
# 1min MACD 盯盘、定时盘前分析都读这个池子；带点/不带点/纯 6 位数字均可
STOCK_POOL=sz300454,sz300369
# 盯盘轮询间隔（秒）与同一标的同向信号冷却（分钟）
MACD_POLL_INTERVAL=20
MACD_COOLDOWN_MIN=5

# ===== 邮件（盘前报告 + 盯盘信号）=====
SEND_EMAIL=true
EMAIL_TO=your_mail@qq.com
EMAIL_FROM=your_mail@qq.com
EMAIL_PASS=your_smtp_auth_code
EMAIL_SMTP_SERVER=smtp.qq.com
EMAIL_SMTP_PORT=587

# ===== 盘前大模型精判（可选）=====
# 不配也能跑，会自动退回纯规则词典判定。填 OpenAI 兼容接口即可。
# PREMARKET_LLM_BASE_URL=https://api.deepseek.com/v1
# PREMARKET_LLM_API_KEY=sk-xxxxxxxx
# PREMARKET_LLM_MODEL=deepseek-chat
